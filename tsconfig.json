{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@core": [
        "./core/index.ts"
      ],
      "@core/*": [
        "./core/*"
      ],
      "@design-system": [
        "./design-system/tokens/index.ts"
      ],
      "@design-system/*": [
        "./design-system/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "api/**",
    "web/**",
    "design-system/**"
  ]
}
