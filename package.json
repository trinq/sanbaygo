{
  "name": "sanbaygo-mvp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-picker/picker": "2.9.0",
    "date-fns": "^3.6.0",
    "expo": "~52.0.0",
    "expo-asset": "^57.0.6",
    "expo-blur": "~14.0.3",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^1.26.0",
    "nativewind": "^4.2.6",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "playwright": "^1.61.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.2.0",
    "typescript": "~5.3.0"
  },
  "jest": {
    "passWithNoTests": true,
    "projects": [
      {
        "displayName": "core",
        "preset": "ts-jest",
        "testMatch": [
          "<rootDir>/tests/**/*.test.ts",
          "<rootDir>/core/tests/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^@core$": "<rootDir>/core/index.ts",
          "^@core/(.*)$": "<rootDir>/core/$1"
        },
        "moduleFileExtensions": [
          "ts",
          "tsx",
          "js",
          "jsx"
        ]
      },
      {
        "displayName": "rn",
        "preset": "react-native",
        "testMatch": [
          "<rootDir>/app/**/*.test.ts",
          "<rootDir>/app/**/*.test.tsx"
        ],
        "moduleNameMapper": {
          "^@core$": "<rootDir>/core/index.ts",
          "^@core/(.*)$": "<rootDir>/core/$1"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-navigation|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-clone-referenced-element|@testing-library|react-native-web)/)"
        ],
        "transform": {
          "^.+\\.(js|ts|tsx)$": [
            "babel-jest",
            {
              "configFile": "./babel.config.test.js"
            }
          ]
        },
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ]
      }
    ]
  }
}
